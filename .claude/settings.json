{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -P -m graphite agent-hook pre-tool-use --mode strict"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -P -m aramid agent-hook pre-tool-use"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -P -m graphite agent-hook session-start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -P -m aramid agent-hook session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -P -m graphite agent-hook stop"
          }
        ]
      }
    ]
  }
}
