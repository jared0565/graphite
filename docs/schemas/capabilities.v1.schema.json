{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jared0565/graphite/docs/schemas/capabilities.v1.schema.json",
  "title": "graphite capabilities v1",
  "description": "Response of `graphite capabilities --json`: the machine-readable contract agents should read instead of guessing commands, query verbs, limits, or the natural-language grammar. Top-level additional keys are allowed (additive evolution; additionalProperties:true is explicit because graphite's subset validator treats absence as closed); the keys listed as required here are the stable v1 surface.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ok",
    "schema_version",
    "commands",
    "query_verbs",
    "search",
    "query_limits",
    "query_plans",
    "natural_language",
    "node_kinds",
    "edge_relations",
    "limits"
  ],
  "properties": {
    "ok": {"const": true},
    "schema_version": {"const": 1},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "query_verbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "aliases", "arguments", "description", "targets", "limits"],
        "properties": {
          "name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "arguments": {"type": "string"},
          "description": {"type": "string"},
          "targets": {
            "type": "array",
            "items": {"type": "string", "enum": ["node", "source", "target"]}
          },
          "limits": {
            "type": "object",
            "properties": {
              "max_depth": {"type": "integer"},
              "max_results": {"type": "integer"}
            }
          }
        }
      }
    },
    "search": {
      "type": "object",
      "required": ["default_limit", "max_limit"],
      "properties": {
        "default_limit": {"type": "integer"},
        "max_limit": {"type": "integer"}
      }
    },
    "query_limits": {
      "type": "object",
      "required": ["default_max_depth", "default_max_results"],
      "properties": {
        "default_max_depth": {"type": "integer"},
        "default_max_results": {"type": "integer"}
      }
    },
    "query_plans": {
      "type": "object",
      "required": ["plan_version", "flags"],
      "properties": {
        "plan_version": {"const": 1},
        "flags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "natural_language": {
      "type": "object",
      "required": ["available", "mode", "flag", "providers", "intents"],
      "properties": {
        "available": {"const": true},
        "mode": {"const": "deterministic-grammar"},
        "flag": {"type": "string"},
        "providers": {"const": false},
        "intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["intent", "kind", "templates"],
            "properties": {
              "intent": {"type": "string"},
              "kind": {"type": "string", "enum": ["operation", "command"]},
              "templates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "node_kinds": {"type": "array", "items": {"type": "string"}},
    "edge_relations": {"type": "array", "items": {"type": "string"}},
    "limits": {
      "type": "object",
      "required": ["max_graph_bytes"],
      "properties": {"max_graph_bytes": {"type": "integer"}}
    }
  }
}
